# SPDX-License-Identifier: MPL-2.0

set -euo pipefail

if [[ "$(uname -r)" == *gvisor* ]]; then
  nix_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/nix"
  mkdir -p "$nix_config_dir"
  if ! grep -Fqx 'sandbox = false' "$nix_config_dir/nix.conf" 2>/dev/null; then
    printf '\nsandbox = false\n' >>"$nix_config_dir/nix.conf"
  fi
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix_profile="$HOME/.nix-profile"

step() {
  printf '\n==> %s\n' "$1"
}

if [[ -x "$nix_profile/bin/nix" ]]; then
  export PATH="$nix_profile/bin:$PATH"
fi
nix_path="$(command -v nix)"
nix store info >/dev/null

step "Configuring Nix for login shells"
profile_marker="# deploy-rx Nix environment"
touch "$HOME/.bash_profile"
tmp="$(mktemp)"
awk -v marker="$profile_marker" '
  $0 == marker { skip = 1 }
  skip && $0 == "fi" { skip = 0; next }
  !skip { print }
' "$HOME/.bash_profile" >"$tmp"
cat >>"$tmp" <<EOF
$profile_marker
if [[ -z "\${IN_NIX_SHELL:-}" && "\${PWD}" == "$repo_root" ]]; then
  eval "\$("$nix_path" print-dev-env "$repo_root")"
  export PATH="$(dirname "$nix_path"):\${PATH}"
fi
EOF
mv "$tmp" "$HOME/.bash_profile"

step "Warming the Nix development shell"
"$nix_path" print-dev-env "$repo_root" >/dev/null
